{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noSvgWithoutTitle": "warn",
                "useButtonType": "warn",
                "useFocusableInteractive": "warn",
                "useKeyWithClickEvents": "warn"
            },
            "correctness": {
                "noSwitchDeclarations": "off",
                "noUnknownProperty": "warn",
                "useExhaustiveDependencies": "warn",
                "useJsxKeyInIterable": "warn"
            },
            "suspicious": {
                "noDoubleEquals": "warn",
                "noArrayIndexKey": "warn"
            }
        }
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "es5",
            "arrowParentheses": "asNeeded",
            "quoteStyle": "single"
        }
    },
    "html": {
        "parser": {
            "interpolation": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/tsconfig*.json"],
            "json": {
                "parser": {
                    "allowComments": true,
                    "allowTrailingCommas": true
                }
            }
        }
    ]
}
